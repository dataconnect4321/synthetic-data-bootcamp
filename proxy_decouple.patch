@@ -0,0 +1,171 @@
+"""Tests for proxy decoupling (post-hoc merge/expand and the in-model term).
+
+Run:  python -m pytest tests/test_proxy_decouple.py -v
+"""
+
+import os
+import sys
+import numpy as np
+import torch
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                                '..', 'tabsyn-main', 'tabsyn-main'))
+
+from tabsyn.vae.proxy_decouple import (detect_proxy_classes, merge_proxies,
+                                       fit_member_tables, expand_merged,
+                                       proxy_member_labels,
+                                       impossible_combination_rate,
+                                       proxy_member_dependence)
+from tabsyn.vae.flip_fairness import (AdversaryHead, proxy_decoupling_loss,
+                                      proxy_decoupling_dim,
+                                      proxy_decoupling_features,
+                                      multi_stage_disentanglement_loss)
+from tabsyn.vae.model import Model_VAE
+
+
+def toy_table(n=4000, seed=0):
+    """col0 = S (0/1), col1 = relationship-like proxy:
+    0=husband (S=1), 1=wife (S=0), 2=other (mixed); col2 = a feature that
+    depends on the proxy member (husband -> 1 more often)."""
+    rng = np.random.default_rng(seed)
+    s = rng.integers(0, 2, n)
+    spouse = rng.random(n) < 0.5
+    rel = np.where(spouse, np.where(s == 1, 0, 1), 2)
+    feat = np.where(rel == 0, rng.random(n) < 0.8,
+                    rng.random(n) < 0.2).astype(int)
+    return np.stack([s, rel, feat], axis=1)
+
+
+# --------------------------------------------------------------------------
+# Detection / merge / expand
+# --------------------------------------------------------------------------
+
+def test_detect_finds_cross_group_class_only():
+    cat = toy_table()
+    cls = detect_proxy_classes(cat, s_idx=0)
+    assert len(cls) == 1
+    assert cls[0]['col'] == 1 and cls[0]['members'] == [0, 1]
+    assert cls[0]['group_of'] == {0: 1, 1: 0}
+
+
+def test_detect_skips_same_group_and_excluded():
+    cat = toy_table()
+    # an excluded column is never a proxy
+    assert detect_proxy_classes(cat, s_idx=0, exclude=(1,)) == []
+    # only ONE flagged category (cat 1 is pure S=0; cat 0 is mixed): nothing
+    # to decouple, so no class
+    s = cat[:, 0]
+    one_sided = np.where(s == 1, 0,
+                         np.random.default_rng(1).integers(0, 2, len(s)))
+    cat2 = np.stack([s, one_sided], axis=1)
+    cls = detect_proxy_classes(cat2, s_idx=0)
+    assert cls == []
+
+
+def test_merge_and_expand_tau0_is_consistent():
+    cat = toy_table()
+    cls = detect_proxy_classes(cat, s_idx=0)
+    tb = fit_member_tables(cat, 0, cls)
+    merged = merge_proxies(cat, cls)
+    assert set(np.unique(merged[:, 1])) == {0, 2}
+    out = expand_merged(merged, cat[:, 0], cls, tb, tau=0.0)
+    # tau=0: member follows S -> reproduces the real column almost exactly
+    assert (out[:, 1] == cat[:, 1]).mean() > 0.99
+    assert impossible_combination_rate(out, cat, 0)['any'] < 0.01
+
+
+def test_expand_tau1_decouples_member_from_features():
+    cat = toy_table()
+    cls = detect_proxy_classes(cat, s_idx=0)
+    tb = fit_member_tables(cat, 0, cls)
+    out = expand_merged(merge_proxies(cat, cls), cat[:, 0], cls, tb, tau=1.0)
+    # rows outside the class are untouched
+    other = cat[:, 1] == 2
+    assert (out[other, 1] == 2).all()
+    # member shares within the class match the real marginal
+    in_cls = out[:, 1] != 2
+    real_share = (cat[cat[:, 1] != 2, 1] == 0).mean()
+    assert abs((out[in_cls, 1] == 0).mean() - real_share) < 0.04
+    # 'male wives' appear (about half the spouse rows)
+    assert impossible_combination_rate(out, cat, 0)['any'] > 0.15
+    # and the member is no longer predictable from the other feature
+    dep = proxy_member_dependence(out, cls, exclude=(0,))[0]
+    dep_real = proxy_member_dependence(cat, cls, exclude=(0,))[0]
+    assert dep_real > 0.7 and dep < 0.56
+
+
+def test_member_labels():
+    cat = toy_table(200)
+    cls = detect_proxy_classes(cat, s_idx=0, min_support=0.0)
+    (lab, mask), = proxy_member_labels(cat, cls)
+    assert (mask == (cat[:, 1] != 2)).all()
+    assert (lab[cat[:, 1] == 1] == 1).all() and (lab[cat[:, 1] == 0] == 0).all()
+
+
+# --------------------------------------------------------------------------
+# In-model term
+# --------------------------------------------------------------------------
+
+def _model_and_stages(n=64, seed=0):
+    torch.manual_seed(seed)
+    categories = [2, 3, 2]          # S, proxy, feature
+    d_num, d_token = 2, 4
+    m = Model_VAE(1, d_num, categories, d_token, n_head=1, factor=4)
+    cat = torch.tensor(toy_table(n, seed))
+    num = torch.randn(n, d_num)
+    return m, num, cat, categories, d_num, d_token
+
+
+def test_proxy_feature_dim_matches_head():
+    m, num, cat, categories, d_num, d_token = _model_and_stages()
+    st = m.forward_with_stages(num, cat)
+    x = proxy_decoupling_features(st, s_idx=0, proxy_col=1)
+    n_tokens = st['mu_z'].shape[1]
+    assert x.shape[1] == proxy_decoupling_dim(n_tokens, d_token, d_num,
+                                              categories, 0, 1)
+
+
+def test_proxy_loss_masks_rows_outside_class():
+    m, num, cat, categories, d_num, d_token = _model_and_stages()
+    st = m.forward_with_stages(num, cat)
+    head = AdversaryHead(proxy_decoupling_dim(st['mu_z'].shape[1], d_token,
+                                              d_num, categories, 0, 1), 2)
+    assert proxy_decoupling_loss(head, st, cat, 0, 1, [0, 1]).item() > 0
+    cat_none = cat.clone()
+    cat_none[:, 1] = 2
+    st2 = m.forward_with_stages(num, cat_none)
+    assert proxy_decoupling_loss(head, st2, cat_none, 0, 1, [0, 1]).item() == 0
+
+
+def test_proxy_loss_reverses_gradient_into_encoder():
+    m, num, cat, categories, d_num, d_token = _model_and_stages()
+    W = m.VAE.encoder_mu.layers[0]['linear0'].weight
+    torch.manual_seed(123)
+    st = m.forward_with_stages(num, cat)
+    head = AdversaryHead(proxy_decoupling_dim(st['mu_z'].shape[1], d_token,
+                                              d_num, categories, 0, 1), 2)
+    proxy_decoupling_loss(head, st, cat, 0, 1, [0, 1]).backward()
+    g_rev = W.grad.clone()
+    m.zero_grad(); head.zero_grad()
+    torch.manual_seed(123)              # same reparameterization noise
+    st3 = m.forward_with_stages(num, cat)
+    x = proxy_decoupling_features(st3, 0, 1)
+    lab = (cat[:, 1] == 1).long()
+    mask = (cat[:, 1] != 2).float()
+    ((torch.nn.functional.cross_entropy(head.net(x), lab, reduction='none')
+      * mask).sum() / x.shape[0]).backward()
+    assert g_rev.abs().max() > 0
+    assert torch.allclose(g_rev, -W.grad, atol=1e-6)
+
+
+def test_disentanglement_exclude_cols_drops_proxy():
+    m, num, cat, categories, d_num, d_token = _model_and_stages(256)
+    st = m.forward_with_stages(num, cat)
+    g = cat[:, 0].long()
+    full = multi_stage_disentanglement_loss(st, g, s_idx=0)
+    excl = multi_stage_disentanglement_loss(st, g, s_idx=0, exclude_cols=[1])
+    assert torch.isfinite(full) and torch.isfinite(excl)
+    assert not torch.allclose(full, excl)
+    # excluding nothing == default
+    assert torch.allclose(full, multi_stage_disentanglement_loss(
+        st, g, s_idx=0, exclude_cols=[]))
