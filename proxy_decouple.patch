+def proxy_token_indices(d_num, proxy_col):
+    """Token positions of categorical column `proxy_col`: in the latent mu_z
+    ([CLS, num_1..num_d, cat_1..cat_k]) and in the decoder output h
+    (decoder(z[:, 1:]) -> [num_1..num_d, cat_1..cat_k])."""
+    return 1 + d_num + proxy_col, d_num + proxy_col
+
+
+def proxy_decoupling_features(stages, s_idx, proxy_col):
+    """Inputs of the in-model proxy-decoupling adversary: everything the rest
+    of the representation offers about a row EXCEPT the proxy column itself
+    and the protected column - the latent tokens of the other columns
+    (flattened) and the decoded logits of the other columns."""
+    mu = stages['mu_z']
+    d_num = stages['recon_x_num'].shape[1]
+    lat_p, _ = proxy_token_indices(d_num, proxy_col)
+    lat_s, _ = proxy_token_indices(d_num, s_idx)
+    keep = [t for t in range(mu.shape[1]) if t not in (lat_p, lat_s)]
+    feats = [mu[:, keep].reshape(mu.shape[0], -1), stages['recon_x_num']]
+    for i, c in enumerate(stages['recon_x_cat']):
+        if i in (s_idx, proxy_col):
+            continue
+        feats.append(c)
+    return torch.cat(feats, dim=1)
+
+
+def proxy_decoupling_dim(n_tokens, d_token, d_num, categories, s_idx,
+                         proxy_col):
+    """Input width of proxy_decoupling_features (for building the head)."""
+    return ((n_tokens - 2) * d_token + d_num + sum(categories)
+            - categories[s_idx] - categories[proxy_col])
+
+
+def proxy_member_targets(x_cat, proxy_col, members):
+    """(labels, mask) for a batch: index of the row's category within
+    `members` (0 outside the class) and a 0/1 class-membership mask."""
+    col = x_cat[:, proxy_col]
+    lab = torch.zeros_like(col)
+    mask = torch.zeros_like(col, dtype=torch.bool)
+    for k, c in enumerate(members):
+        hit = col == c
+        lab[hit] = k
+        mask |= hit
+    return lab, mask
+
+
+def proxy_decoupling_loss(head, stages, x_cat, s_idx, proxy_col, members,
+                          lambd=1.0):
+    """In-model proxy decoupling: a gradient-reversal adversary predicts, for
+    rows in a merged proxy class (e.g. relationship in {Husband, Wife}),
+    WHICH member the row is from the other columns' latent tokens and
+    decoded logits. Reversing its gradient removes the protected-specific
+    label from the rest of the representation while the proxy token itself
+    keeps it (the column is still reconstructed faithfully). The
+    legitimate component ('is a spouse') is untouched: rows outside the
+    class are masked out.
+
+    Per-record CE masked to class rows, averaged over the BATCH (not summed):
+    the reconstruction/KL terms in compute_loss are batch means, so a summed
+    CE would be ~batch_size times larger and swamp them (an early smoke run
+    with a sum collapsed numeric fidelity at weight 1). Still a sum of
+    per-record terms over a batch-size constant -> DP-decomposable (Opacus
+    pass 1).
+    """
+    lab, mask = proxy_member_targets(x_cat, proxy_col, members)
+    if not bool(mask.any()):
+        return stages['mu_z'].sum() * 0.0
+    x = proxy_decoupling_features(stages, s_idx, proxy_col)
+    logits = head(x, lambd)
+    ce = torch.nn.functional.cross_entropy(logits, lab, reduction='none')
+    return (ce * mask.float()).sum() / x.shape[0]
+
